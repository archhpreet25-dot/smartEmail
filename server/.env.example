PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smartmail
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# SMTP is optional. Leave blank and emails are delivered inside the app only
# (the Nodemailer step is simulated). Example for Gmail: use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
